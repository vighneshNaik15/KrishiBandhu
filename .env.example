NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_CROP_DOCTOR_API_URL=http://localhost:8000

# Optional; required only by server-side Gemini features. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Only needed for server-side admin operations (never expose to client)
# FIREBASE_ADMIN_PRIVATE_KEY=your_private_key
# FIREBASE_ADMIN_CLIENT_EMAIL=your_client_email
