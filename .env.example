# Copy the values from a single Firebase web app's SDK configuration.
# These identifiers are public. Firestore Security Rules control access to data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Optional. Use the actual bucket name only for reading previously saved photos.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Optional. Use the public HTTPS base URL of the separately hosted FastAPI service.
# For local testing only, set this to http://localhost:8000 in .env.local.
NEXT_PUBLIC_CROP_DOCTOR_API_URL=

# Optional server-only key for advisory and scheme search. Keep it out of NEXT_PUBLIC_*.
GEMINI_API_KEY=
# Optional Firebase project API key for the server's Identity Toolkit requests.
# Set this if the Firebase web API key has browser-only referrer restrictions.
FIREBASE_AUTH_API_KEY=

# Local demo project only. Leave this disabled for Vercel.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1
